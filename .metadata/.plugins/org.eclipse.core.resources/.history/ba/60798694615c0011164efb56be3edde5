@WebServlet("/viewExpanse")
public class ViewExpanseServlet extends HttpServlet {

    @Override
    protected void doGet(HttpServletRequest req, HttpServletResponse resp)
            throws ServletException, IOException {

        HttpSession hs = req.getSession(false);

        if (hs == null || hs.getAttribute("loginUser") == null) {
            resp.sendRedirect("login.jsp");
            return;
        }

        User user = (User) hs.getAttribute("loginUser");

        Session session = FactoryProvider.getFactory().openSession();

        Query<Expanse> query = session.createQuery(
                "from Expanse e where e.user.id=:uid",
                Expanse.class);

        query.setParameter("uid", user.getId());

        List<Expanse> list = query.list();

        System.out.println("User Id = " + user.getId());
        System.out.println("List Size = " + list.size());

        req.setAttribute("exList", list);

        req.getRequestDispatcher("user/view_expanse.jsp")
           .forward(req, resp);

        session.close();
    }
}