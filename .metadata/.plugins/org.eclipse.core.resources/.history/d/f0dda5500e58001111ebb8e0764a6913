<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Register Page</title>
<%@ include file="component/all_css_js.jsp"%>
<style type="text/css">
.card-sh {
	box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
	/* box-shadow: 0px 0px 10px gray; */
}
</style>
</head>
<body class="bg-light">
	<%@ include file="component/navbar.jsp"%>
	<div class="container p-5">
		<div class="row">
			<div class="col-md-6 offset-md-3">
				<div class="card card-sh mt-5">
					<div class="card-header">
						<h1>
							<p class="text-center fs-3">Login Page</p>
						</h1>
					</div>
					<div class="card-body">
						<form method="" action="">
							<div class="mb-3">
								<label>Enter email</label> <input type="name" name="email"
									class="form-control" placeHolder="Enter email here">
							</div>
							<div class="mb-3">
								<label>Enter password</label> <input type="password"
									name="password" class="form-control"
									placeHolder="Enter your password">
							</div>
							<div class="text-center mt-4">
								<button type="login" class="btn btn-success col-md-6">Login</button>
								<div class="text-center mt-2">
									Don't have account <a href="register.jsp" class="btn btn-link">Register
									</a>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</body>
</html>