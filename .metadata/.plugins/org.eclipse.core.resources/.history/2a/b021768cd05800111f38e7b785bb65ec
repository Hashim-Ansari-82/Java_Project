<%@page import="java.util.List"%>
<%@page import="org.hibernate.query.Query"%>
<%@page import="com.track.entity.User"%>
<%@page import="org.hibernate.Session"%>
<%@page import="com.track.helper.FactoryProvider"%>
<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@page isELIgnored="false"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>User Detail page</title>
<%@ include file="../component/all_css_js.jsp"%>
<style type="text/css">
.card-sh {
	box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
}
</style>
</head>
<body>

	<%@ include file="../component/navbar.jsp"%>
	<div
		class="container-fluid d-flex justify-content-center align-items-center"
		style="height: 90vh;">

		<%
		User u = (User) session.getAttribute("loginUser");
		%>
		<div class="card-sh py-5 px-4 row"
			style="width: 55%; border-radius: 35px;">
			<h1 class="text-center;" style="color: green">User Login Successfully</h1>
			<br>
			<div class="card-body text-start">

				<h3>User id ---------------- <%=u.getId()%></h3><br>
				
				<h3>User Name ------------ <%=u.getName()%></h3><br>
				
				<h3>User Email ------------ <%=u.getEmail()%></h3><br>
				
				<h3>User Password -------- <%=u.getPassword()%></h3><br>
				
				<h3>About User ------------ <%=u.getAbout()%></h3>

			</div>
			<div class="text-center mt-4">

				<a href="../logout" class="btn btn-danger px-4 col-md-6"> Logout </a>

			</div>
		</div>

	</div>

</body>
</html>