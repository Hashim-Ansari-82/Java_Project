package com.track.servlet;

import java.io.IOException;
import java.io.Serializable;
import java.sql.Time;
import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.Date;

import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

import org.hibernate.Session;
import org.hibernate.Transaction;

import com.track.entity.Expanse;
import com.track.entity.User;
import com.track.helper.FactoryProvider;

@WebServlet("/saveExpanse")
public class SaveExpanseServlet extends HttpServlet {

	private static final long serialVersionUID = 1L;

	@Override
	protected void doGet(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {

		Session session = FactoryProvider.getFactory().openSession();
		Transaction tx = session.beginTransaction();

		String title = req.getParameter("title");
		String date = req.getParameter("date");
		String time = req.getParameter("time");
		String desc = req.getParameter("description");
		Double price = Double.parseDouble(req.getParameter("price"));
		
		HttpSession httpSession = req.getSession();
		User user = (User)httpSession.getAttribute("userLogin");

		Expanse expanse = new Expanse(title, date, time, desc,price,user);
		
		int save = (Integer)session.save(expanse);
		tx.commit();
	}

}
